{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "AASHI AI Companion",
	"version": "1.0.0",
	"identifier": "com.aashi.desktop-agent",
	"build": {
		"beforeDevCommand": "npm --prefix ../../frontend run dev",
		"beforeBuildCommand": "npm --prefix ../../frontend run build",
		"devUrl": "http://localhost:5173",
		"frontendDist": "../../frontend/dist"
	},
	"app": {
		"withGlobalTauri": false,
		"windows": [
			{
				"label": "main",
				"title": "AASHI AI Companion",
				"width": 1180,
				"height": 760,
				"minWidth": 760,
				"minHeight": 520,
				"resizable": true,
				"visible": true,
				"decorations": false,
				"transparent": true,
				"center": true,
				"skipTaskbar": false
			}
		],
		"security": {
			"csp": "default-src 'self' ipc: http://ipc.localhost http://localhost:8000 http://localhost:5173; connect-src 'self' ipc: http://ipc.localhost http://localhost:8000 ws://localhost:8000 ws://localhost:5173; img-src 'self' asset: data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-eval'"
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": []
	}
}
